{
  "name": "jax-toolbox-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Local tooling environment for the JAX-Toolbox Fern documentation site",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "docs:export":  "node fern/export-tutorials.mjs",
    "docs:export:check": "node fern/export-tutorials.mjs --check",
    "docs:dev":     "npm run docs:export && fern docs dev",
    "docs:check":   "npm run docs:export:check && fern check",
    "docs:preview": "npm run docs:export:check && fern generate --docs --preview",
    "docs:publish": "npm run docs:export:check && fern generate --docs",
    "fern":         "fern"
  },
  "devDependencies": {
    "fern-api": "5.56.3"
  }
}
